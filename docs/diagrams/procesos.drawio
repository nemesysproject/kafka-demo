  <diagram id="diag_proc" name="Flujo de Procesos y Detección de Fraude">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1020" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="proc_banner" parent="1" value="&lt;b&gt;DIAGRAMA DE PROCESOS: DETECCIÓN Y EVALUACIÓN DE FRAUDE EN DOS CAPAS&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:12px;font-weight:normal;color:#94A3B8;'&gt;Flujo de Eventos: Ingesta Kafka KRaft ➔ Filtro Heurístico Ultrarrápido (&amp;lt;2ms) ➔ Análisis Cognitivo IA (Qwen 2.5) ➔ Alerta &amp; Dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1">
          <mxGeometry x="40" y="20" width="1280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lane_ingest" parent="1" value="&lt;b&gt;1. INGESTA &amp;amp; STREAMING&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Pasarelas de Pago &amp;amp; Apache Kafka KRaft&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
          <mxGeometry x="40" y="95" width="280" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane_tier1" parent="1" value="&lt;b&gt;2. TIER 1: FAST-PATH HEURÍSTICO (&amp;lt; 2ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Motor en Memoria (Rust Tokio + rdkafka)&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
          <mxGeometry x="330" y="95" width="340" height="880" as="geometry"/>
        </mxCell>
        <mxCell id="lane_tier2" parent="1" value="&lt;b&gt;3. TIER 2: EVALUACIÓN COGNITIVA IA&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Ollama + Qwen 2.5 1.5B (Inferencia CPU Local)&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#581C87;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
          <mxGeometry x="680" y="95" width="320" height="880" as="geometry"/>
