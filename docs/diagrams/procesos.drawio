        <mxCell id="p_start" parent="1" value="&lt;b&gt;INICIO&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;'&gt;Cliente realiza compra en E-Commerce&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=11;align=center;" vertex="1">
