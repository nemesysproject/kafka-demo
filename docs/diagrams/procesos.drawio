        <mxCell id="lane_notify" parent="1" value="&lt;b&gt;4. DIFUSIÓN &amp;amp; AUDITORÍA EN VIVO&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Kafka Topic &lt;code&gt;fraud-alerts&lt;/code&gt; &amp;amp; Dashboard Angular&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
