        <mxCell id="p_eval_rules" parent="1" value="&lt;b&gt;Evaluación Tier 1 en Memoria (&amp;lt; 2ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px;color:#713F12;'&gt;&lt;b&gt;&lt;code&gt;FraudRuleEngine::evaluate(&amp;amp;tx)&lt;/code&gt;&lt;/b&gt;&lt;br/&gt;1. Monto &amp;gt;= $5,000 (Monto Excesivo)&lt;br/&gt;2. Historial de usuario &amp;gt; 3 ops en 30s (Velocidad)&lt;br/&gt;3. País en [NK, SY, IR, RU] (Geo Riesgo)&lt;br/&gt;4. Monto &amp;lt;= $1.00 (Prueba de Tarjeta)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF08A;strokeColor=#CA8A04;strokeWidth=2;fontColor=#713F12;fontSize=10;align=center;shadow=1;" vertex="1">
