        <mxCell id="p_rust_consume" parent="1" value="&lt;b&gt;Consumo Asíncrono de Stream&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#064E3B;'&gt;&lt;code&gt;StreamConsumer::recv().await&lt;/code&gt;&lt;br/&gt;Deserialización en &lt;code&gt;Transaction&lt;/code&gt; struct&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;fontColor=#064E3B;fontSize=10;align=center;" vertex="1">
