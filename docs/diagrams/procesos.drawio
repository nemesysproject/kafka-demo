        <mxCell id="p_create_alert_obj" parent="1" value="&lt;b&gt;Genera Alerta Base&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px;color:#991B1B;'&gt;• Asigna UUID Alerta&lt;br/&gt;• Severidad: CRITICAL / HIGH / MED&lt;br/&gt;• Score inicial: 65 - 95&lt;br/&gt;• Despacha &lt;code&gt;tokio::spawn&lt;/code&gt; asíncrono&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;align=center;" vertex="1">
