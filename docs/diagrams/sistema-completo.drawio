        <mxCell id="proc_banner" parent="1" value="&lt;b&gt;DIAGRAMA DE PROCESOS: DETECCIÓN Y EVALUACIÓN DE FRAUDE EN DOS CAPAS&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:12px;font-weight:normal;color:#94A3B8;'&gt;Flujo de Eventos: Ingesta Kafka KRaft ➔ Filtro Heurístico Ultrarrápido (&amp;lt;2ms) ➔ Análisis Cognitivo IA (Qwen 2.5) ➔ Alerta &amp; Dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1">
