        </mxCell>
        <mxCell id="lane_tier1" parent="1" value="&lt;b&gt;2. TIER 1: FAST-PATH HEURÍSTICO (&amp;lt; 2ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Motor en Memoria (Rust Tokio + rdkafka)&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
