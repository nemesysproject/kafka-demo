        </mxCell>
        <mxCell id="lane_ingest" parent="1" value="&lt;b&gt;1. INGESTA &amp;amp; STREAMING&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;font-weight:normal;'&gt;Pasarelas de Pago &amp;amp; Apache Kafka KRaft&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;collapsible=0;dropTarget=0;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=11;fontStyle=1;startSize=40;arcSize=6;" vertex="1">
